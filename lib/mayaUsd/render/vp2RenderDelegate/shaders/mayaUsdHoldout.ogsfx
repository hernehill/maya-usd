// mayaUsdHoldout.ogsfx
// Holdout / matte shader for USD prims in Maya VP2.0
// Writes depth, outputs black with alpha=0.

uniform mat4 gWVPXf : WorldViewProjection
<
    string UIWidget = "None";
    bool rowMajor = true;
>;

attribute VS_INPUT
{
    vec3 Pos : POSITION;
};

attribute VS_TO_PS
{
    // None
};

attribute pixelOut
{
    vec4 colorOut : COLOR0;
}

GLSLShader VS_Holdout
{
    void main()
    {
        gl_Position = gWVPXf * vec4(Pos, 1.0);
    }
}

GLSLShader PS_Holdout
{
    void main()
    {
        colorOut = vec4(0.0, 0.0, 0.0, 0.0);
    }
}

technique Holdout
{
    pass P0
    {
        VertexShader (in VS_INPUT, out VS_TO_PS) = VS_Holdout;
        PixelShader (in VS_TO_PS, out pixelOut) = PS_Holdout;
    }
}